# secrets.yaml - DO NOT COMMIT THIS FILE TO GIT

# RIPE Atlas API Key (Create Measurement permission required)
ripe_atlas_key: "00000000-0000-0000-0000-000000000000"

# Optional: Add other keys here in the future
# bgp_tools_token: "..."


# Optional: Globalping API token (globalping_verify.py, shadow mode). Leave it out to stay
# anonymous: 250 tests an hour per source IP, which is enough for the nightly budget of 200.
# A free token gives 500 an hour but needs an account, and Globalping's terms forbid using a
# token and anonymous access together to stack allowances: pacific-peering on this host would
# have to use the same token.
# globalping_token: "..."
